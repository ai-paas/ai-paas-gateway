# ai-paas-gateway 환경변수 예시. 값은 모두 기본값 또는 placeholder.
# 필수: DATABASE_URL, JWT_SECRET_KEY
# 각 변수의 실제 기본값은 app/config.py 가 단일 소스.

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ── App ─────────────────────────────────────────────────────────────────
API_V1_STR=/api/v1
PROJECT_NAME=AIPaaS Gateway Management API
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=info

# ── Logging ─────────────────────────────────────────────────────────────
LOG_DIR=var/log
LOG_FILE_ENABLED=true
LOG_ACCESS_ENABLED=true
LOG_UVICORN_ACCESS_ENABLED=false
LOG_JSON_FORMAT=false
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=10
# 액세스 로그에서 본문을 마스킹할 경로
LOG_ACCESS_MASK_PATHS=["/api/v1/auth/login","/api/v1/auth/refresh","/api/v1/auth/logout"]

# ── CORS ────────────────────────────────────────────────────────────────
# "*" / 쉼표구분 / JSON 배열 모두 가능. credentials=true 면 "*" 를 쓰지 말 것.
CORS_ALLOW_ORIGINS=*
# IP 대역 등 패턴이 필요할 때. 예: ^https?://10\.0\.0\.\d{1,3}(:\d+)?$
CORS_ALLOW_ORIGIN_REGEX=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_HTTPONLY=true
AUTH_REFRESH_COOKIE_SECURE=false
# cross-site 브라우저 환경이면 none + https 필요
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# ── Upload ──────────────────────────────────────────────────────────────
PROXY_UPLOAD_TIMEOUT=300.0
MAX_DATASET_FILE_SIZE=1073741824

# ── Provider: MLOps / Surro (PROXY) ─────────────────────────────────────
PROXY_ENABLED=false
PROXY_TARGET_BASE_URL=https://api.example.com
PROXY_TARGET_PATH_PREFIX=/api/v1
PROXY_TIMEOUT=30.0
PROXY_CONNECT_TIMEOUT=5.0
PROXY_STRUCTURE_PREDICTION_TIMEOUT=300.0
PROXY_MAX_CONNECTIONS=100
PROXY_MAX_KEEPALIVE_CONNECTIONS=20
EXTERNAL_API_USERNAME=your-username
EXTERNAL_API_PASSWORD=your-password

# ── Provider: Hub Connect ───────────────────────────────────────────────
HUB_CONNECT_ENABLED=false
HUB_CONNECT_TARGET_BASE_URL=http://127.0.0.1:8001
HUB_CONNECT_TARGET_PATH_PREFIX=/api/v1
HUB_CONNECT_TIMEOUT=30.0
HUB_CONNECT_CONNECT_TIMEOUT=5.0
HUB_CONNECT_MAX_CONNECTIONS=100
HUB_CONNECT_MAX_KEEPALIVE_CONNECTIONS=20
HUB_CONNECT_API_USERNAME=change-me
HUB_CONNECT_API_PASSWORD=change-me

# ── Provider: Any Cloud ─────────────────────────────────────────────────
ANY_CLOUD_ENABLED=false
ANY_CLOUD_TARGET_BASE_URL=http://127.0.0.1:8888
# pod exec WebSocket 대상. 비우면 TARGET_BASE_URL 의 scheme 만 ws/wss 로 치환.
ANY_CLOUD_TARGET_WS_URL=
ANY_CLOUD_TIMEOUT=30.0
ANY_CLOUD_CONNECT_TIMEOUT=5.0
ANY_CLOUD_MAX_CONNECTIONS=100
ANY_CLOUD_MAX_KEEPALIVE_CONNECTIONS=20

# ── Dashboard ───────────────────────────────────────────────────────────
DASHBOARD_CACHE_TTL_MINUTES=10
DASHBOARD_INCLUDE_MODEL_COUNT=true

# ── Scheduler ───────────────────────────────────────────────────────────
# true: uvicorn 프로세스 안에서 함께 동작 (단일 워커/개발용)
# false: 별도 컨테이너에서 ENABLE_SCHEDULER=true 로 `python -m app.scheduler` 실행 (운영 권장)
ENABLE_SCHEDULER=false
SCHEDULER_TRENDS_HOUR=0
SCHEDULER_MV_REFRESH_MINUTES=30
SCHEDULER_API_METRICS_FLUSH_MINUTES=1
SCHEDULER_PROVIDER_HEALTH_MINUTES=1
SCHEDULER_DASHBOARD_REFRESH_MINUTES=10
SCHEDULER_INCLUDE_DASHBOARD=true
# 별도 scheduler worker 로 분리하면 false (worker 는 빈 in-memory buffer 만 봄)
SCHEDULER_INCLUDE_API_METRICS=true
# MLOps visibility → is_catalog 캐시 정정 backstop. 목록 조회가 read-through 하므로 기본 off.
SCHEDULER_INCLUDE_MODEL_VISIBILITY=false
SCHEDULER_MODEL_VISIBILITY_MINUTES=30
# MLOps 에서 사라진 워크플로우의 stale 매핑 soft-delete
SCHEDULER_INCLUDE_WORKFLOW_RECONCILE=false
SCHEDULER_WORKFLOW_RECONCILE_MINUTES=30
